# TrustGate Environment Configuration
# Copy this file to .env and fill in values as needed

# Server Configuration
PORT=3000

# Hedera Testnet Configuration
HEDERA_NETWORK=testnet
OPERATOR_ID=0.0.your.account.id.testnet
OPERATOR_PRIVATE_KEY=ed25519:your.private.key.here

# x402 Facilitator URL (optional)
# FACILITATOR_URL = https://x402-facilitator.example.com

# HCS Node Endpoint (optional)
# HCS_NODE_URL = https://hedera.hcsnode.net/testnet
