# Hedera Testnet x402 Configuration
# Copy this to .env and update with your real account credentials from https://portal.hedera.com/dispensatory

# Payer Account (client-side signer for payments)
# Get testnet HBAR at: https://testnet.cobify.io/ faucet
TEST_PAYER_ACCOUNT_ID=0.0.testpayer.x402.demo
TEST_PAYER_PRIVATE_KEY=<your_test_payer_private_key_here>
# Note: Ensure your account has sufficient balance (>= payment amount + 0.00001 HBAR)

# Facilitator Fee Payer (signs transactions for consensus submission)
FACILITATOR_FEE_PAYER_ID=0.0.fee.x402.testnet.demo
FACILITATOR_FEE_PAYER_PRIVATE_KEY=<your_fee_payer_private_key_here>

# Operator Account for SDK operations (needed to configure Hedera client)
OPERATOR_ID=0.0.15882187
OPERATOR_PRIVATE_KEY=<operator_private_key_here>

# Facilitator Configuration
NETWORK=hedera:testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
FACILITATOR_PORT=3002
OFFICIAL_FACILITATOR_URL=https://x402-hedera-production.up.railway.app/

# USDC Token ID for x402 payments (on testnet)
USDC_TOKEN_ID=0.0.429274
USDC_AMOUNT_HBAR=1  # Amount of HBAR to transfer for payment

# TrustGate Reputation Policy
TRUSTED_THRESHOLD=3  # Successful deliveries needed before trusted status
